{
  "app": {
    "name": "Co-op",
    "tagline": "Your Business, Smarter.",
    "environment": "testing",
    "version": "1.0.0",
    "debug": true
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "timeoutMs": 10000
  },
  "database": {
    "driver": "sqlite+aiosqlite",
    "name": "coop_test.db"
  },
  "sync": {
    "enabled": false,
    "mode": "disabled",
    "intervalSeconds": 0
  },
  "ai": {
    "enabled": true,
    "model": "gpt-4o-mini",
    "credits_per_request": 1,
    "free_output_tokens": 500,
    "credits_per_1k_output_tokens": 1
  },
  "features": {
    "dashboard": true,
    "orders": true,
    "inventory": true,
    "customers": true,
    "aiAssistant": false,
    "reports": true,
    "cloudSync": false
  },
  "ui": {
    "defaultTheme": "light",
    "sidebarCollapsed": false,
    "commandPaletteShortcut": "Ctrl+K"
  },
  "logging": {
    "level": "warning"
  },
  "billing": {
    "plans": {
      "free": {
        "label": "Free",
        "credits_per_month": 25
      },
      "starter": {
        "label": "Starter",
        "credits_per_month": 200
      },
      "professional": {
        "label": "Professional",
        "credits_per_month": 1000
      },
      "enterprise": {
        "label": "Enterprise",
        "credits_per_month": null
      }
    }
  }
}
