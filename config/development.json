{
  "app": {
    "name": "Co-op",
    "tagline": "Your Business, Smarter.",
    "environment": "development",
    "version": "1.0.0",
    "debug": true
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "timeoutMs": 30000
  },
  "database": {
    "driver": "postgresql+asyncpg",
    "host": "localhost",
    "port": 5432,
    "name": "coop"
  },
  "sync": {
    "enabled": false,
    "mode": "background",
    "intervalSeconds": 30
  },
  "ai": {
    "enabled": true,
    "model": "gpt-4o-mini",
    "credits_per_request": 1,
    "free_output_tokens": 500,
    "credits_per_1k_output_tokens": 1
  },
  "features": {
    "dashboard": true,
    "orders": true,
    "inventory": true,
    "customers": true,
    "aiAssistant": true,
    "reports": true,
    "cloudSync": false
  },
  "ui": {
    "defaultTheme": "light",
    "sidebarCollapsed": false,
    "commandPaletteShortcut": "Ctrl+K"
  },
  "logging": {
    "level": "debug"
  }
}
