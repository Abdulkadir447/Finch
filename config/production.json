{
  "app": {
    "name": "Co-op",
    "tagline": "Your Business, Smarter.",
    "environment": "production",
    "version": "1.0.0",
    "debug": false
  },
  "api": {
    "baseUrl": "https://api.coop.app",
    "timeoutMs": 15000
  },
  "database": {
    "driver": "postgresql+asyncpg",
    "host": "db.coop.app",
    "port": 5432,
    "name": "coop"
  },
  "sync": {
    "enabled": true,
    "mode": "background",
    "intervalSeconds": 60
  },
  "ai": {
    "enabled": true,
    "model": "gpt-4o-mini",
    "credits_per_request": 1,
    "free_output_tokens": 500,
    "credits_per_1k_output_tokens": 1,
    "rate_limit": {
      "requests": 8,
      "window_seconds": 60
    }
  },
  "features": {
    "dashboard": true,
    "orders": true,
    "inventory": true,
    "customers": true,
    "aiAssistant": true,
    "reports": true,
    "cloudSync": true
  },
  "ui": {
    "defaultTheme": "system",
    "sidebarCollapsed": false,
    "commandPaletteShortcut": "Ctrl+K"
  },
  "logging": {
    "level": "error"
  },
  "billing": {
    "plans": {
      "free": {
        "label": "Free",
        "credits_per_month": 25
      },
      "starter": {
        "label": "Starter",
        "credits_per_month": 200
      },
      "professional": {
        "label": "Professional",
        "credits_per_month": 1000
      },
      "enterprise": {
        "label": "Enterprise",
        "credits_per_month": null
      }
    }
  },
  "cors": {
    "_comment": "CORS allow-list used when CORS_ORIGINS env is unset. Production refuses to start if both are empty.",
    "origins": [
      "https://app.coop.example"
    ]
  }
}
