# Co-op environment — copy to `.env` and fill in. Never commit real values.

# --- Frontend (Vite) -------------------------------------------------------
# Clerk publishable key (frontend-only). Required at build/dev time.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: override the API base URL (defaults to same-origin /api).
# VITE_API_URL=http://localhost:8000

# --- Backend ---------------------------------------------------------------
# REQUIRED in production and development: Supabase/Postgres connection string.
# SQLite is used only when COOP_ENV=testing.
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/coop

# REQUIRED in production: Clerk Frontend API host (token issuer/JWKS).
# The dev default (bursting-swan-43.clerk.accounts.dev) is refused in prod.
CLERK_FRONTEND_API=your-instance.clerk.accounts.dev

# Comma-separated azp (origin) allow-list for Clerk session tokens.
CLERK_ALLOWED_ORIGINS=https://app.coop.example

# Comma-separated CORS allow-list. Development/testing default to "*".
# PRODUCTION refuses to start with an open CORS policy: set this or the
# cors.origins entry in config/production.json (fail-fast at startup).
CORS_ORIGINS=https://app.coop.example

# Environment: development | testing | production
COOP_ENV=development

# --- Tests ------------------------------------------------------------------
# Optional Postgres URL: enables the true-concurrency stock test.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/coop_test

# --- AI (Ask Co-op real assistant) ------------------------------------------
# Optional but enables the real LLM path. Without it, Ask Co-op gracefully
# falls back to the deterministic verified engine (AI never blocks core ops).
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini
# Per-user rate limit on /ai/chat lives in config/<env>.json
# (ai.rate_limit {requests, window_seconds}); requests <= 0 disables it.

# ---- Daily summary email delivery (SMTP; secrets never live in config/*.json) ----
# Leave SMTP_HOST empty to keep the channel off (endpoint answers 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Co-op <no-reply@coop.app>
SMTP_TLS=true

